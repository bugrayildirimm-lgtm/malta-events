# Malta Event Guide - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (PostgreSQL - Required)
# ============================================
DB_USER=your_db_user
DB_HOST=your_db_host_or_ip
DB_NAME=malta_events
DB_PASSWORD=your_secure_password
DB_PORT=5432

# ============================================
# ADMIN ACCESS (Required)
# ============================================
# Used for /admin routes. Change this in production!
ADMIN_PASSWORD=change_this_to_something_strong

# ============================================
# OPTIONAL: Email / Newsletter (Brevo / Sendinblue)
# ============================================
# BREVO_SMTP_KEY=your_brevo_smtp_key
# BREVO_SENDER=hello@maltaeventguide.com

# ============================================
# OPTIONAL: Server Port
# ============================================
# PORT=3000

# Notes:
# - The app will work with just the DB + ADMIN_PASSWORD variables.
# - SSL is set to rejectUnauthorized: false for the DB connection (common for managed Postgres).
# - Never commit your real .env file.
